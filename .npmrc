# =============================================================================
# pnpm Security Configuration - HogarIA
# =============================================================================
# Maximum security settings for supply-chain attack prevention

# --- Script Execution ---
# Only allow scripts for specific packages (configured in package.json)
ignore-scripts=false

# --- Dependency Resolution ---
# Strict peer dependency checking (fail on conflicts)
strict-peer-dependencies=false
auto-install-peers=true

# --- Lockfile ---
# Strict lockfile - fail if lockfile is out of sync
lockfile-strict=true

# --- Version Resolution ---
# Use highest resolved versions
resolution-mode=highest

# --- Network ---
# Prefer offline packages (faster + no network surprises)
prefer-offline=true

# --- Audit ---
# Fail on moderate+ vulnerabilities
audit-level=moderate

# --- Telemetry & Metadata ---
# Disable fund messages
fund=false
# Disable update notifications
update-notifier=false
# Disable progress bars (CI friendly)
progress=false

# --- Registry ---
# Use official npm registry only
registry=https://registry.npmjs.org/

# --- Package Integrity ---
# Verify package integrity
verify-store-integrity=true

# --- Node.js ---
# Engine strict mode
engine-strict=true
